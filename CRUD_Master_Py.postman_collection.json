  "item": [
    {
      "name": "Inventory API",
      "description": "Direct Inventory API CRUD and filtering tests.",
      "item": [
        {
          "name": "1. Create Movie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Created movie is returned and its ID is saved', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('id');",
                  "    pm.expect(data.title).to.eql('Postman Inventory Audit Movie');",
                  "    pm.expect(data.description).to.eql('Created directly through Inventory');",
                  "    pm.collectionVariables.set('inventory_movie_id', data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Inventory Audit Movie\",\n  \"description\": \"Created directly through Inventory\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{inventoryUrl}}/api/movies/"
          }
        },
        {
          "name": "2. Get All Movies",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response contains the created movie', function () {",
                  "    const data = pm.response.json();",
                  "    const id = Number(pm.collectionVariables.get('inventory_movie_id'));",
                  "    pm.expect(data).to.be.an('array');",
                  "    pm.expect(data.some(movie => movie.id === id)).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventoryUrl}}/api/movies/"
          }
        },
        {
          "name": "3. Filter Movies By Title",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Every result matches the title filter', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array').that.is.not.empty;",
                  "    data.forEach(movie => pm.expect(movie.title.toLowerCase()).to.include('inventory audit'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventoryUrl}}/api/movies?title=Inventory%20Audit"
          }
        },
